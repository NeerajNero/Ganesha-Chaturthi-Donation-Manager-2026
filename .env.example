DATABASE_URL=            # Neon POOLED connection string
JWT_SECRET=              # long random string
ADMIN_USERNAME=          # seeded super admin
ADMIN_PASSWORD=          # seeded super admin (plain here, hashed in seed)
ADMIN_NAME=              # display name
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=     # e.g. @gu2026channel or -100xxxx
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=   # unsigned preset
NEXT_PUBLIC_UPI_ID=      # committee UPI id, e.g. gu2026@oksbi
NEXT_PUBLIC_UPI_NAME=    # payee name shown in UPI apps
NEXT_PUBLIC_APP_URL=     # e.g. https://gu2026.vercel.app (for receipt links)
